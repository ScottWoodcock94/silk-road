<form class="h-96 flex flex-col justify-between items-start" action="/users/<%= @user.id %>" method="POST">
  <input type="hidden" name="_method" value="PUT">

  <div class="flex flex-col">
    <label class="text-indigo-800" for="username">Username</label>
    <input class="mt-3.5 border-b-2 border-purple-900 text-indigo-900 pb-2" type="text" name="username" placeholder="Username123" value="<%= @user.username %>">
  </div>

  <div class="flex flex-col">
    <label class="text-indigo-800" for="username">Email</label>
    <input class="mt-3.5 border-b-2 border-purple-900 text-indigo-900 pb-2" type="email" name="email" placeholder="user@email.com" value="<%= @user.email %>">
  </div>

  <div class="flex flex-col">
    <label class="text-indigo-800" for="password">Password</label>
    <input class="mt-3.5 border-b-2 border-purple-900 text-indigo-900 pb-2" type="password" name="password" placeholder="••••••••••••" value="<%= @user.password %>">
  </div>

  <input class="text-indigo-500 hover:cursor-pointer hover:text-indigo-600" type="submit" value="Save Changes">
</form>